# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋되지 않는다(.gitignore).
# 배포 지갑 0x299e421dEC65933Ed64E38ce16F536FE2271a2Ac 의 개인키
DEPLOYER_PRIVATE_KEY=0x

# 관리자(세 역할). 비우면 배포 지갑이 관리자가 된다.
ADMIN_ADDRESS=

# 보상 파라미터 (시험용 기본값)
REWARD_PER_SHARE=1
DAILY_CAP_PER_WALLET=50
EPOCH_CAP=500
TARGET_INTERVAL_SEC=60
SHARES_PER_EPOCH=30
MIN_SHARE_INTERVAL_SEC=60

# 예상 전체 해시레이트(H/s) → 초기 난이도. 노트북 1대 ≈ 1,000,000
INITIAL_NETWORK_HPS=1000000

# 배포 직후 보상 풀에 넣을 MST
INITIAL_FUND=10000
