# ── API 서버 ─────────────────────────────
PORT=8787
# 관리자 페이지 접속 토큰 (openssl rand -hex 32 로 생성)
ADMIN_TOKEN=change-me
DB_PATH=./data/bridge.db

# ── Verus 노드 (verusd JSON-RPC) ─────────
# 도커에서 호스트의 verusd에 붙을 때: http://host.docker.internal:27486
VERUS_RPC_URL=http://127.0.0.1:27486
VERUS_RPC_USER=verusrpc
VERUS_RPC_PASS=change-me
# 입금 인정 확인 수 (Verus 블록 약 1분)
VERUS_MIN_CONF=10
# 최소 입금 (VRSC) — 이보다 작으면 발행하지 않음
MIN_DEPOSIT=0.1
# 언래핑 시 사용자 몫에서 빼는 Verus 송금 수수료 (VRSC)
REDEEM_FEE=0.0001

# ── VYD 체인 ─────────────────────────────
VYD_RPC=https://vyd.mustree.kr
VYD_CHAIN_ID=7603
TOKEN_ADDRESS=0x...
TOKEN_DEPLOY_BLOCK=0
# MINTER_ROLE을 받은 브리지 전용 지갑 개인키 (관리자 키와 분리할 것)
MINTER_KEY=0x...
# 언래핑 이벤트 인정 확인 블록 수 (VYD 블록 2초)
VYD_CONFIRMATIONS=6

# ── 채굴 ─────────────────────────────────
# 솔로 채굴(코인베이스)·풀 지급금이 들어오는 Verus 주소를 이 EVM 주소에 묶어 래핑
MINING_REWARD_EVM=0x675f62d61b909995cbbc31bc5cbe85e1e2c7e812

# 작업 주기 (ms)
POLL_INTERVAL_MS=20000
